{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/collection?c=men",
        "http://localhost:3100/products/heritage-three-piece"
      ],
      "numberOfRuns": 5,
      "settings": {
        "onlyCategories": [
          "performance"
        ],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.65,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 400,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 6500,
            "aggregationMethod": "median-run"
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 1400000,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
